# raon-quant/config/common.env — 전 stage 공용 설정. 각 .sh가 source 한다.
# 사용: source "$(dirname "$0")/config/common.env" [smoke|full]
# 템플릿: llama-3.2-1b-to-math-model/config/common.env (학습용 STRAT/DDP/FSDP 제거, PTQ-only).
# infra: INFRA=dgx-spark-1x|dgx-spark-2x (기본 1x). 첫 인자 smoke|full (기본 smoke).

RQ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$RQ_ROOT/.." && pwd)"

PROFILE="${PROFILE:-1x}"
if [ -z "${INFRA:-}" ]; then INFRA="dgx-spark-${PROFILE}"; fi
case "$INFRA" in
  dgx-spark-1x|1x) INFRA="dgx-spark-1x"; PROFILE="1x" ;;
  dgx-spark-2x|2x) INFRA="dgx-spark-2x"; PROFILE="2x" ;;
  *) echo "unknown INFRA=$INFRA" >&2; return 1 2>/dev/null || exit 1 ;;
esac
if [ -f "$REPO_ROOT/infra/$INFRA/env.sh" ]; then
  source "$REPO_ROOT/infra/$INFRA/env.sh"
elif [ -f "$RQ_ROOT/infra/$INFRA/env.sh" ]; then
  source "$RQ_ROOT/infra/$INFRA/env.sh"
else
  : "${UV_TORCH_BACKEND:=cu130}"
  export UV_TORCH_BACKEND
fi

MODE="${1:-${MODE:-smoke}}"
case "$MODE" in smoke|full) ;; *) echo "usage: $0 [smoke|full]" >&2; return 1 2>/dev/null || exit 1 ;; esac

# ---- 모델/HF ----
# Raon-1-mini-preview는 gated (자동 승인) + custom_code (trust_remote_code 필수).
# BASE_REVISION: 첫 다운로드 후 고정할 것 (현재 floating).
HF_ID="${HF_ID:-tayaee}"
BASE_MODEL="${BASE_MODEL:-KRAFTON/Raon-1-mini-preview}"
# NOTE: 메인 repo 가중치는 MXFP8 저장 (F8_E4M3 9216 + 스케일, 2026-10-22 실측).
# BF16 공개 repo 없음 (형제: nvfp4/gguf/mlx/dflash2). 5종 PTQ는 이중양자화 전제.
# REVISION은 2026-10-22 실측 캐시 스냅샷. 빈 값이면 Hub 최신(floating).
BASE_REVISION="${BASE_REVISION:-da4cf162c8613993f2189ebb438a5f9a23f3e5ca}"
export BASE_REVISION
UV_MIN="${UV_MIN:-0.11.8}"
export UV_MIN

# ---- 공용 경로 (양 노드 동일) ----
RQ_DIRNAME="$(basename "$RQ_ROOT")"
RQ_SHARED="${RQ_SHARED:-/rosenas/data/AIML/${RQ_DIRNAME}-shared}"
RQ_DATASETS="$RQ_SHARED/datasets"
RQ_MODELS="$RQ_SHARED/models"
RQ_OUTPUTS="$RQ_SHARED/outputs"
export RQ_SHARED RQ_DATASETS RQ_MODELS RQ_OUTPUTS
mkdir -p "$RQ_DATASETS" "$RQ_MODELS" "$RQ_OUTPUTS"
: "${HF_HOME:=$RQ_SHARED/hf-cache}"
: "${VLLM_CACHE_DIR:=$RQ_SHARED/vllm-cache}"
export HF_HOME VLLM_CACHE_DIR
# FastTokenizer+Datasets 스레딩 충돌 경고 방지 (양자화·calib에 병렬 토크나이저 불필요).
export TOKENIZERS_PARALLELISM=false

export UV_NO_SYNC=1
: "${UV_TORCH_BACKEND:=cu130}"
export UV_TORCH_BACKEND
# GPU 메모리 단편화 OOM 방지 (GB10 unified 128GB, sequential 누적 대비).
# expandable_segments가 꺼면 2GB/layer씩 unified 메모리에 고착돼 OOM (smoke 3회 확인).
# CPU-only 폴백보다 느린 선택지는 없으므로 (full이 불가능) 기본 ON. 끄려면 빈 값으로 export.
: "${PYTORCH_CUDA_ALLOC_CONF:=expandable_segments:True}"
export PYTORCH_CUDA_ALLOC_CONF
unset VIRTUAL_ENV
for _uvd in "$HOME/.local/bin" "$HOME/.local/share/mise/installs/uv/latest/.mise-bins"; do
  case ":${PATH}:" in
    *:"$_uvd":*) ;;
    *) [ -d "$_uvd" ] && export PATH="$_uvd:$PATH" ;;
  esac
done
unset _uvd
VENV_BIN="$RQ_ROOT/.venv/bin"
VLLM_BIN="$VENV_BIN/vllm"; [ -x "$VLLM_BIN" ] || VLLM_BIN=vllm
HF_BIN="$VENV_BIN/hf"; [ -x "$HF_BIN" ] || HF_BIN=hf
export VENV_BIN VLLM_BIN HF_BIN

# ---- SDLC 공통: 원장 · 게이트 ----
# 원장(ledger): 각 단계가 status/artifact를 남긴다. s4-37-release-notes.py가 이걸
# 릴리스 노트로 굽는다. 기록 실패는 파이프라인을 막지 않는다(증빙 부재로 죽이지 않음).
RQ_PY="$VENV_BIN/python"; [ -x "$RQ_PY" ] || RQ_PY="$(command -v python3 || true)"
export RQ_PY
RQ_LEDGER="$RQ_OUTPUTS/stage-ledger-$MODE.json"
export RQ_LEDGER

rq_stage_record() {
  # rq_stage_record <stage_id> <name> <status> [artifact...]
  local sid="$1" name="$2" status="$3"; shift 3
  local -a _args=(--mode "$MODE" --stage "$sid" --name "$name" --status "$status")
  local _a
  for _a in "$@"; do _args+=(--artifact "$_a"); done
  "$RQ_PY" "$RQ_ROOT/sdlc.py" ledger "${_args[@]}" >/dev/null 2>&1 \
    || rq_log "warn: 단계 원장 기록 실패 (stage=$sid name=$name)"
}

rq_stage_target() {
  # rq_stage_target <stage_id> <name> <status> <target> [artifact...]
  local sid="$1" name="$2" status="$3" target="$4"; shift 4
  local -a _args=(--mode "$MODE" --stage "$sid" --name "$name" --status "$status" --target "$target")
  local _a
  for _a in "$@"; do _args+=(--artifact "$_a"); done
  "$RQ_PY" "$RQ_ROOT/sdlc.py" ledger "${_args[@]}" >/dev/null 2>&1 \
    || rq_log "warn: 단계 원장 기록 실패 (stage=$sid target=$target)"
}

# 스테이지 ID ↔ 스텝 이름 매핑 (원장 기록·릴리스 노트가 공유한다).
# 스텝 번호(01·04·…)는 그룹 안에서만 유일하므로 번호가 아니라 slug로 매칭한다.
# (sN-##- 접두사가 있든 bare 이름이든 동일하게 동작한다.)
rq_stage_of() {
  case "$1" in
    s0-*) echo "0 base" ;;
    s5-*) echo "5 upload" ;;
    s6-*) echo "6 cat-tf" ;;
    s7-*) echo "7 cat-vllm" ;;
    *setup*) echo "1 setup" ;;
    *acceptance*) echo "1 acceptance" ;;
    *calib*) echo "1 calib" ;;
    *compat*) echo "1 compat" ;;
    *dequant*) echo "2 dequant" ;;
    *quant-*|gate-quant*) echo "3 quant" ;;
    *ppl*) echo "4 measure" ;;
    *eval*|*gsm8k*|*kmmluko*|*format*|*servebench*|*bench-transformers*|*prep*|*verify-upload*|*-verify) echo "4 eval" ;;
    *release*|*upload*) echo "5 upload" ;;
    *serve*|*serving*|*infer*) echo "7 cat-vllm" ;;
    *) echo "" ;;
  esac
}

# 타깃별 기대 압축 포맷 (게이트가 대조할 계약).
rq_quant_format() {
  case "$1" in
    awq-w3-transformers|awq-w5-transformers) echo "pack-quantized" ;;
    nvfp4-awq-transformers|nvfp4-gptq-transformers) echo "nvfp4-pack-quantized" ;;
    nvfp4-awq-vllm) echo "mopt-nvfp4" ;;
    *) echo "" ;;
  esac
}

# 스텝 이름 → 양자화 타깃 (원장에 타깃별 상태로 쌓기 위해). slug 매칭.
rq_target_of() {
  case "$1" in
    *awq-w3-transformers*) echo "awq-w3-transformers" ;;
    *awq-w5-transformers*) echo "awq-w5-transformers" ;;
    *nvfp4-awq-vllm*) echo "nvfp4-awq-vllm" ;;
    *nvfp4-awq-transformers*) echo "nvfp4-awq-transformers" ;;
    *nvfp4-gptq-transformers*) echo "nvfp4-gptq-transformers" ;;
    *) echo "" ;;
  esac
}

# 게이트 모음(SDLC의 단계 간 계약). 모든 스크립트가 source하므로 여기서 함께 로드한다.
if [ -f "$RQ_ROOT/gates.inc" ]; then source "$RQ_ROOT/gates.inc"; fi

# ---- 병렬/서빙 (2x 기본, TP=2) ----
if [ "$PROFILE" = "2x" ]; then
  : "${TP:=2}"
  : "${NODE_RANK:=0}"; : "${MASTER_PORT:=29500}"
  if [ -z "${MASTER_ADDR:-}" ]; then echo "2x needs MASTER_ADDR (spark1 IP)" >&2; return 1 2>/dev/null || exit 1; fi
else
  : "${TP:=1}"
fi
export TP NODE_RANK MASTER_ADDR MASTER_PORT

# ---- smoke/full 스케일 (PTQ-only) ----
# 환경변수로 미리 지정되면 존중 (PIPELINE_TEST 모드 전파용), 아니면 모드 기본값.
if [ "$MODE" = "smoke" ]; then
  : "${CALIB_N:=8}"; : "${SEQ_LEN:=512}"; : "${EVAL_N:=20}"; : "${PPL_N:=8}"
else
  : "${CALIB_N:=256}"; : "${SEQ_LEN:=2048}"; : "${EVAL_N:=200}"; : "${PPL_N:=32}"
fi
export CALIB_N SEQ_LEN EVAL_N PPL_N
# 평가(표준 GSM8K) 관련 기본값
#   GSM8K_N   : s4-04-prep-gsm8k가 만드는 표본 수 (0 = 표준 테스트셋 전체 1319)
#   EVAL_N   : s4-07-eval-base.sh/s4-10-eval-quantized.sh가 그중 앞에서부터 사용할 문제 수 (EVAL_N <= GSM8K_N)
#   EVAL_BATCH: transformers 생성 배치 크기 (1=단건). GPU 메모리에 맞춰 조절.
: "${GSM8K_N:=0}"
: "${EVAL_BENCHMARKS:=gsm8k,kmmluko,format}"
: "${KMMLU_N:=40}"
: "${KMMLU_SUBJECTS:=Biology,Chemistry,Computer-Science,Economics,Korean-History,Law,Math,Management}"
if [ "$MODE" = "full" ]; then
  # full은 EVAL_N=200과 같은 200문항 KMMLU로 고정한다 (40으로 덮어쓰면 기존
  # 200문항 스코어와 비교 단절 + s7-37 freshness가 깨져 전체 재평가가 돈다).
  KMMLU_N=200
fi
export KMMLU_N KMMLU_SUBJECTS
: "${EVAL_BATCH:=8}"
export GSM8K_N EVAL_BENCHMARKS EVAL_BATCH
: "${CALIB_FILE:=$RQ_DATASETS/raon-calibration-$CALIB_N.jsonl}"
export CALIB_FILE

# rq_require_serving <port> <serve_log> <owner-script> — 서빙 전제 확인.
# 포트 열림 → 0(진행). 닫힘 + 로그에 FAIL 흔적 → 1(실패 전파).
# 닫힘 + 흔적 없음(SKIP/미실행) → 2(건너뜀).
rq_require_serving() {
  local _port="$1" _log="$2" _owner="$3"
  if ss -ltn 2>/dev/null | grep -q ":${_port} "; then return 0; fi
  if [ -f "$_log" ] && grep -q "FAIL" "$_log" 2>/dev/null; then
    echo "FAIL: PORT=$_port 서버 없음 + $_owner 실패 흔적 (상세: $_log)" >&2
    return 1
  fi
  echo "SKIP: PORT=$_port 서버 없음 ($_owner 미실행 — 먼저 실행)" >&2
  return 2
}

# ---- 타깃 명시 강제 (암묵적 전체 실행 금지) ----
# rq_hf_parse <model|target> <mode> — HF repo id 또는 short target을 받아
# RQ_HF_REPO(리포지토리 id)와 RQ_HF_TARGET(short target, 모르면 빈 값)을 정한다.
#   전체 id ("tayaee/...-nvfp4-awq-transformers[-smoke]") → suffix로 타깃 판별
#   short ("nvfp4-awq-transformers") → 모드에 맞는 repo id 조립 ("all"이면 TARGETS_RUN 4종)
# 사용: rq_hf_parse "${2:-nvfp4-awq-transformers}" "$MODE" → $RQ_HF_REPO / $RQ_HF_TARGET / $RQ_HF_TARGETS_RUN
rq_hf_parse() {
  local _in="${1:-nvfp4-awq-transformers}" _mode="${2:-${MODE:-smoke}}"
  RQ_HF_REPO=""; RQ_HF_TARGET=""; RQ_HF_TARGETS_RUN=""
  local _id="$_in"
  if [ "${_id}" = all ]; then
    RQ_HF_TARGETS_RUN="awq-w3-transformers awq-w5-transformers nvfp4-awq-vllm nvfp4-awq-transformers nvfp4-gptq-transformers"
    return 0
  fi
  case "$_id" in
    */*) RQ_HF_REPO="$_id" ;;
    *) RQ_HF_REPO="tayaee/${BASE_MODEL##*/}-$_id"; [ "$_mode" = smoke ] && RQ_HF_REPO="$RQ_HF_REPO-smoke" ;;
  esac
  local _base="${RQ_HF_REPO%-smoke}"
  case "$_base" in
    *-awq-w3-transformers) RQ_HF_TARGET="awq-w3-transformers" ;;
    *-awq-w5-transformers) RQ_HF_TARGET="awq-w5-transformers" ;;
    *-nvfp4-awq-vllm) RQ_HF_TARGET="nvfp4-awq-vllm" ;;
    *-nvfp4-awq-transformers) RQ_HF_TARGET="nvfp4-awq-transformers" ;;
    *-nvfp4-gptq-transformers) RQ_HF_TARGET="nvfp4-gptq-transformers" ;;
  esac
  RQ_HF_TARGETS_RUN="${RQ_HF_TARGET:-$_id}"
}
# rq_require_targets — $2 인자 또는 TARGETS 환경변수로 타깃이 없으면
# 사용법을 출력하고 status 2를 반환한다 ("all"은 허용, 명시 목록으로 펴는 것은 호출자 몫).
# 사용: TARGETS="$(rq_require_targets "<예시 호출>" "${2:-}" <허용값...>)" || exit 2
rq_require_targets() {
  local _ex="$1" _pos="${2:-}"; shift 2
  local _allowed="$*"
  local _val="${_pos:-${TARGETS:-}}"
  if [ -z "$_val" ]; then
    echo "TARGETS is not specified — you must name the target(s)." >&2
    echo "" >&2
    echo "Available values: ${_allowed} | all" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  ${_ex} <target>              # a single target" >&2
    echo "  TARGETS=all ${_ex}           # all targets" >&2
    return 2
  fi
  printf '%s' "$_val"
}

rq_log() { echo "[PROFILE=$PROFILE][INFRA=$INFRA][MODE=$MODE] $*"; }

# transformers로 적재 불가한 타깃 (vLLM 전용 포맷). PPL/eval은 transformers
# 전제라 이 타깃들은 SKIP 기록을 남기고 통과한다. 품질 게이트는 s7 서빙이 맡는다.
TRANSFORMERS_UNLOADABLE="nvfp4-awq-vllm"
rq_skip_transformers() {
  case " $TRANSFORMERS_UNLOADABLE " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

# 시작 시 1줄 설명(영어). 어떤 스크립트가 무엇을 하는지 바로 보이게 한다.
# 사용: rq_banner "<script-id>" "<one-line english description>"
rq_banner() {
  printf '[%s] %s\n' "$1" "$2"
}

rq_require() {
  local f
  for f in "$@"; do
    [ -e "$f" ] || { echo "[$INFRA][$MODE] missing input: $f (run previous stage first)" >&2; exit 1; }
  done
}
rq_fresh() {
  [ "${FORCE:-0}" = 1 ] && return 1
  local out="$1"; shift
  [ $# -ge 1 ] || { echo "rq_fresh: need OUT IN..." >&2; return 1; }
  [ -e "$out" ] || return 1
  local f
  for f in "$@"; do
    [ -e "$f" ] || return 1
    [ "$out" -nt "$f" ] || return 1
  done
  return 0
}

# ---- 공유 OUT 단일-writer (flock) ----
rq_lock() {
  command -v flock >/dev/null || { echo "flock missing (util-linux)" >&2; return 1; }
  local lockdir="$RQ_SHARED/.locks"
  mkdir -p "$lockdir" 2>/dev/null || [ -d "$lockdir" ] \
    || { echo "cannot mkdir $lockdir" >&2; return 1; }
  mkdir -p "$1" 2>/dev/null || [ -d "$1" ] \
    || { echo "cannot mkdir $1" >&2; return 1; }
  exec 9>"$lockdir/$(basename "$1").lock"
  if [ "${2:-wait}" = "nowait" ]; then
    flock -n 9 || { echo "REFUSE: $1 locked (중복 실행?) — 먼저 끝낸 뒤 재실행" >&2; return 1; }
  else
    flock 9
  fi
  ls "$1" >/dev/null 2>&1 || true
}

# ---- 스탬프(freshness) ----
# "이미 준비된 단계를 건너뛰기"용. rq_fresh는 파일 mtime 비교라
# 환경 준비 상태(설치 버전·GPU 등)에는 쓸 수 없다 → key=value 스탬프 파일로 판정.
# 사용: rq_stamp_ok <file> <key> <current-value>  → 스탬프에 같은 값이 있으면 0
#       rq_stamp_write <file> <key> <value> ...
rq_stamp_ok() {
  local f="$1" k="$2" v="$3" have
  [ -f "$f" ] || return 1
  [ -n "$v" ] || return 1
  have="$(sed -n "s/^${k}=//p" "$f" | head -1)"
  [ -n "$have" ] && [ "$have" = "$v" ]
}

rq_stamp_write() {
  local f="$1"; shift
  local tmp="$f.tmp"
  : >"$tmp"
  while [ $# -ge 2 ]; do printf '%s=%s\n' "$1" "$2" >>"$tmp"; shift 2; done
  mv "$tmp" "$f"
}

# ---- 실패 시 재실행줄 ----
RQ_SCRIPT_PATH=""
_RQ_SRC="${BASH_SOURCE[1]:-}"
if [ -n "$_RQ_SRC" ]; then
  RQ_SCRIPT_PATH="$(cd "$(dirname "$_RQ_SRC")" && pwd)/$(basename "$_RQ_SRC")"
fi
unset _RQ_SRC
RQ_SCRIPT="$(basename "${BASH_SOURCE[1]:-$0}")"
rq_repro_cmd() {
  local cmd="+ FORCE=1" v
  for v in PROFILE INFRA MODE TP REPORT_TO; do
    case "$v" in
      PROFILE|INFRA|REPORT_TO) ;;
      MODE|TP)
        if [ -n "$RQ_SCRIPT_PATH" ] && [ -r "$RQ_SCRIPT_PATH" ] \
          && ! grep -qE '\$'"$v"'([^[:alnum:]_]|$)' "$RQ_SCRIPT_PATH" \
          && ! grep -qE '\$\{'"$v"'([^[:alnum:]_]|$)' "$RQ_SCRIPT_PATH"; then
          continue
        fi ;;
      *)
        [ "${PROFILE:-2x}" = "2x" ] || continue ;;
    esac
    local val="${!v:-}"
    [ -n "$val" ] || continue
    local q
    printf -v q '%q' "$val"
    cmd="$cmd $v=$q"
  done
  cmd="$cmd ./$RQ_SCRIPT"
  if [ -r /proc/$$/cmdline ]; then
    local -a argv=()
    local a
    while IFS= read -r -d '' a; do argv+=("$a"); done < /proc/$$/cmdline
    local start=1
    if [ "${#argv[@]}" -ge 2 ] && [ "$(basename -- "${argv[1]}")" = "$RQ_SCRIPT" ]; then
      start=2
    fi
    local i q
    for ((i = start; i < ${#argv[@]}; i++)); do
      printf -v q '%q' "${argv[$i]}"
      cmd="$cmd $q"
    done
  fi
  echo "$cmd"
}
rq_repro_echo() {
  local line
  line="$(rq_repro_cmd)"
  if [ -t 1 ]; then printf '\e[32m%s\e[0m\n' "$line"; else echo "$line"; fi
}
rq_repro() {
  local rc="${RQ_RC:-0}"
  if [ "$rc" -ne 0 ] && [ "${BASH_SUBSHELL:-0}" = "0" ]; then
    rq_repro_cmd >&2
  fi
  return "$rc"
}
trap 'RQ_RC=$?; rq_repro' EXIT
