# math-1b-sft-and-quantization/config/common.env — 전 stage 공용 설정. 각 .sh가 source 한다.
# 사용: source "$(dirname "$0")/config/common.env" [mini|full]
# infra 선택: INFRA=dgx-spark-1x|dgx-spark-2x (기본 1x). PROFILE=1x|2x 약칭 가능.

M1B_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$M1B_ROOT/.." && pwd)"  # 구 repo 레이아웃 호환용 (신규 repo는 infra/ 없음)

PROFILE="${PROFILE:-1x}"
if [ -z "${INFRA:-}" ]; then INFRA="dgx-spark-${PROFILE}"; fi
case "$INFRA" in
  dgx-spark-1x|1x) INFRA="dgx-spark-1x"; PROFILE="1x" ;;
  dgx-spark-2x|2x) INFRA="dgx-spark-2x"; PROFILE="2x" ;;
  *) echo "unknown INFRA=$INFRA" >&2; return 1 2>/dev/null || exit 1 ;;
esac
# infra env: 구 repo($REPO_ROOT/infra) → 신 repo($M1B_ROOT/infra) 순으로 탐색, 없으면 내장 기본값으로 동작.
# 신규 repo(math-llm-sft-and-quantization)는 math-1b-sft-and-quantization만 복사되어 infra/가 없음.
# shellcheck source=/dev/null
if [ -f "$REPO_ROOT/infra/$INFRA/env.sh" ]; then
  source "$REPO_ROOT/infra/$INFRA/env.sh"
elif [ -f "$M1B_ROOT/infra/$INFRA/env.sh" ]; then
  source "$M1B_ROOT/infra/$INFRA/env.sh"
else
  : "${UV_TORCH_BACKEND:=cu130}"
  export UV_TORCH_BACKEND
fi

MODE="${1:-${MODE:-mini}}"
case "$MODE" in mini|full) ;; *) echo "usage: $0 [mini|full]" >&2; return 1 2>/dev/null || exit 1 ;; esac

# ---- 모델/HF (리비전 고정 — 1년 후 재현용) ----
# BASE는 unsloth 미러(비가ated, 가중치 동일)를 기본으로 한다.
# meta-llama 원본은 gated(manual 승인 필요)라 tayaee 토큰으로 403이 나며,
# 공유 캐시(/rosenas/.../hf-cache)에도 unsloth만 들어있다.
# REVISION은 2026-10-19 실측 캐시 스냅샷. 빈 값이면 Hub 최신(floating) — 재현 시 반드시 고정.
HF_ID="${HF_ID:-tayaee}"
BASE_MODEL="${BASE_MODEL:-unsloth/Llama-3.2-1B}"
TEACHER_MODEL="${TEACHER_MODEL:-meta-llama/Llama-3.1-8B-Instruct}"
BASE_REVISION="${BASE_REVISION:-9535bd9b1d1dea6acafbdc4813b728796aeb28da}"
TEACHER_REVISION="${TEACHER_REVISION:-0e9e39f249a16976918f6564b8830bc894c89659}"
export BASE_REVISION TEACHER_REVISION
# ---- 외부 git 핀 (2026-10-19 실측 HEAD) ----
MASKED_REV="${MASKED_REV:-9a467afe60b8cd3d89b7b7728557d54539998f48}"
LLAMACPP_REV="${LLAMACPP_REV:-98d5e8ba8a2642710c9871d05ac1033a3328b884}"
export MASKED_REV LLAMACPP_REV
# ---- 툴체인 핀 (실측) ----
# uv>=0.11.8, python==3.12.13(.python-version), torch cu130, driver 580.178.04.
# CUDA는 infra env의 UV_TORCH_BACKEND=cu130으로 고정 (아래 source).
UV_MIN="${UV_MIN:-0.11.8}"
export UV_MIN

# ---- 공용 경로 (양 노드 동일) ----
# 신규 기본값: 현재 디렉토리 이름 기반 (/rosenas/data/AIML/<dir>-shared).
# 구 P5_SHARED가 export되어 있으면 마이그레이션 기간 동안 우선 존중.
M1B_DIRNAME="$(basename "$M1B_ROOT")"
M1B_SHARED="${M1B_SHARED:-${P5_SHARED:-/rosenas/data/AIML/${M1B_DIRNAME}-shared}}"
M1B_DATASETS="$M1B_SHARED/datasets"
M1B_MODELS="$M1B_SHARED/models"
M1B_OUTPUTS="$M1B_SHARED/outputs"
# 구 변수명 호환 alias (외부에서 P5_*를 참조해도 동작)
P5_SHARED="$M1B_SHARED"; P5_DATASETS="$M1B_DATASETS"; P5_MODELS="$M1B_MODELS"; P5_OUTPUTS="$M1B_OUTPUTS"
export M1B_SHARED M1B_DATASETS M1B_MODELS M1B_OUTPUTS P5_SHARED P5_DATASETS P5_MODELS P5_OUTPUTS
mkdir -p "$M1B_DATASETS" "$M1B_MODELS" "$M1B_OUTPUTS"
: "${HF_HOME:=$M1B_SHARED/hf-cache}"
: "${VLLM_CACHE_DIR:=$M1B_SHARED/vllm-cache}"
export HF_HOME VLLM_CACHE_DIR

# ---- 원본 참조 (읽기 전용, 강의 업스트림) ----
# ~/git/maskedthought 에 클론 (10-setup.sh이 없으면 클론). 강의 전용 데이터
# (gsm8k-*.jsonl, template.txt)는 math-1b-sft-and-quantization/data·assets에 벤더링되어 있음.
MASKED="${MASKED:-$HOME/git/maskedthought}"
M1B_DATA="$M1B_ROOT/data"

# ---- venv 고정 (math-1b-sft-and-quantization 전용 .venv 사용) ----
# math-1b-sft-and-quantization는 독립 uv 프로젝트(math-1b-sft-and-quantization/pyproject.toml + uv.lock).
# `uv sync`는 math-1b-sft-and-quantization 디렉토리에서 실행해야 이 venv를 맞춘다.
# UV_NO_SYNC=1: bare `uv run` 자동 sync가 lock과 어긋난 live 패키지를
# 지워버리는 사고 방지 (2026-10-11 trackio 0.42→0.19 revert 실측).
# 환경 재구축은 10-setup.sh 경로로만 수행한다.
export UV_NO_SYNC=1
# torch CUDA 백엔드 고정: uv resolver가 cu130 휠을 선택하도록 함.
# math-1b-sft-and-quantization/pyproject.toml의 torch==2.13.0과 함께 lock 재현에 필수.
: "${UV_TORCH_BACKEND:=cu130}"
export UV_TORCH_BACKEND

# ---- 리포팅 기본값 ----
# 모든 학습에서 trackio 기본 ON. wandb 추가 시 아래 주석 해제.
export REPORT_TO="${REPORT_TO:-trackio}"
# export REPORT_TO="wandb,trackio"
# VIRTUAL_ENV 무효화: 외부 셸의 activate 잔재가 bare `uv pip/run`의 설치 대상을
# 표준 venv(math-1b-sft-and-quantization/.venv)가 아닌 곳으로 돌려버린다. repo 표준은 아래 VENV_BIN이므로 무조건 해제한다.
unset VIRTUAL_ENV
# uv 보장: detached/ssh 실행에서는 mise shims가 PATH에 없어 bare `uv`가
# 127로 죽는다. 알려진 설치 위치를 PATH에 추가 (spark1=~/.local/bin,
# spark2=mise .mise-bins — 양쪽에 모두 적용, 존재하는 것만).
for _uvd in "$HOME/.local/bin" "$HOME/.local/share/mise/installs/uv/latest/.mise-bins"; do
  case ":${PATH}:" in
    *:"$_uvd":*) ;;
    *) [ -d "$_uvd" ] && export PATH="$_uvd:$PATH" ;;
  esac
done
unset _uvd
VENV_BIN="$M1B_ROOT/.venv/bin"
TORCHRUN="$VENV_BIN/torchrun"; [ -x "$TORCHRUN" ] || TORCHRUN=torchrun
VLLM_BIN="$VENV_BIN/vllm"; [ -x "$VLLM_BIN" ] || VLLM_BIN=vllm
HF_BIN="$VENV_BIN/hf"; [ -x "$HF_BIN" ] || HF_BIN=hf
export VENV_BIN TORCHRUN VLLM_BIN HF_BIN

# ---- 병렬 설정 ----
if [ "$PROFILE" = "2x" ]; then
  NPROC=1; NNODES=2; : "${TP:=2}"
  : "${NODE_RANK:=0}"; : "${MASTER_PORT:=29500}"
  if [ -z "${MASTER_ADDR:-}" ]; then echo "2x needs MASTER_ADDR (spark1 IP)" >&2; return 1 2>/dev/null || exit 1; fi
else
  NPROC=1; NNODES=1; : "${TP:=1}"
fi
export NPROC NNODES TP NODE_RANK MASTER_ADDR MASTER_PORT

# ---- mini/full 스케일 ----
if [ "$MODE" = "mini" ]; then
  SYNTH_N=64; EPOCHS=1; CALIB_N=32; EVAL_N=10; GSM_ROWS=256
else
  SYNTH_N=10000; EPOCHS=3; CALIB_N=256; EVAL_N=0; GSM_ROWS=0  # 0=전체
fi
export SYNTH_N EPOCHS CALIB_N EVAL_N GSM_ROWS

m1b_log() { echo "[PROFILE=$PROFILE][INFRA=$INFRA][MODE=$MODE][STRAT=${STRAT:-?}] $*"; }

# ---- make-style freshness (입력/출력 타임스탬프 기반 스킵) ----
# FORCE=1이면 항상 stale 취급(강제 재실행).
# m1b_require <path...> — 입력 존재 확인 (없으면 exit 1).
# m1b_fresh <OUT> <IN...> — OUT이 존재하고 모든 IN보다新이면 0, 아니면 1.
#   OUT/IN에는 반드시 파일(마커)을 넘길 것. 디렉토리를 넘기면 안 된다:
#   양자화 save()/Trainer 저장은 기존 파일을 제자리 덮어쓰기라 디렉토리
#   mtime이 안 바뀌어서, 디렉토리끼리 비교하면 항상 stale이 된다 (53번 재실행 버그).
#   모델 디렉토리 출력물은 마커와 함께 쓸 것:
#     if [ -f "$OUT/config.json" ] && m1b_fresh "$OUT/config.json" "$SRC/config.json"; then ... skip; fi
m1b_require() {
  local f
  for f in "$@"; do
    [ -e "$f" ] || { echo "[$INFRA][$MODE] missing input: $f (run previous stage first)" >&2; exit 1; }
  done
}
m1b_fresh() {
  [ "${FORCE:-0}" = 1 ] && return 1
  local out="$1"; shift
  [ $# -ge 1 ] || { echo "m1b_fresh: need OUT IN..." >&2; return 1; }
  [ -e "$out" ] || return 1
  local f
  for f in "$@"; do
    [ -e "$f" ] || return 1
    [ "$out" -nt "$f" ] || return 1
  done
  return 0
}

# ---- 학습 전략 (single|ddp|fsdp) ----
# single: 단일 GPU 단일 프로세스. 다음 스테이지 입력으로 쓰는 기준 결과물.
# ddp:    2노드 DDP (INFRA=dgx-spark-2x 필수, WORLD=2).
# fsdp:   FSDP full_shard (1x에서는 1proc 학습용, 2x에서는 2proc 실분산).
# effective batch(64)를 월드 크기에 맞춰 동일하게 맞추면 정확도는 거의 같아지지만
# bit-identical은 아니다: allreduce(DDP) vs reduce-scatter+allgather(FSDP)의
# 부동소수점 합산 순서가 다르고, dataloader 샤딩으로 배치 구성도 달라진다.
# 16-compare-strategies.sh로 해시 비교해 직접 확인하는 것이 학습 포인트.
MICRO_BATCH=2; TARGET_EFF_BATCH=64

# m1b_resolve_strat <single|ddp|fsdp> → WORLD, ACCUM, LAUNCH[] 설정
m1b_resolve_strat() {
  STRAT="${1:-single}"
  case "$STRAT" in single|ddp|fsdp) ;;
    *) echo "strategy must be single|ddp|fsdp" >&2; return 1 ;; esac
  case "$STRAT" in
    single) WORLD=1 ;;  # PROFILE=2x여도 로컬 노드만 사용, 다른 노드는 무시
    ddp)
      [ "$PROFILE" = "2x" ] || { echo "ddp needs INFRA=dgx-spark-2x" >&2; return 1; }
      WORLD=2 ;;
    fsdp)
      WORLD="$NNODES"
      [ "$WORLD" = "1" ] && m1b_log "WARN: 1-GPU FSDP, functional check only" ;;
  esac
  ACCUM=$(( TARGET_EFF_BATCH / MICRO_BATCH / WORLD ))
  LAUNCH=("$TORCHRUN" --nproc_per_node="$NPROC")
  if [ "$WORLD" = "2" ]; then
    LAUNCH+=(--nnodes=2 "--node_rank=$NODE_RANK" "--master_addr=$MASTER_ADDR" "--master_port=$MASTER_PORT")
  fi
  export STRAT WORLD ACCUM
}

# ---- 공유 OUT 단일-writer (flock) ----
# 두 노드(또는 두 셸)가 같은 DST에 동시 쓰면 산출물이 섞여 깨진다 (42 실측).
# 먼저 잡은 쪽이 끝내면 나머지는 freshness-skip으로 빠져나간다.
# 락 파일은 $M1B_SHARED/.locks/ 에 둔다 — OUT 안에 두면 commit_dir의 rmtree가
# 열린 .lock(NFS silly-rename 잔재) 때문에 ENOTEMPTY로 죽는다 (32 3연패 실측).
# 학습 스크립트(10/30/31)에는 쓰지 않는다 — 분산 학습은 양쪽이 다 돌려야 한다.
m1b_lock() { # $1 = dir [$2 = nowait] — 공유 OUT 단일-writer 보장.
  # nowait: 잡고 있으면 대기 없이 거부 (중복 solo 학습 방지용).
  command -v flock >/dev/null || { echo "flock missing (util-linux)" >&2; return 1; }
  local lockdir="$M1B_SHARED/.locks"
  mkdir -p "$lockdir" 2>/dev/null || [ -d "$lockdir" ] \
    || { echo "cannot mkdir $lockdir" >&2; return 1; }
  mkdir -p "$1" 2>/dev/null || [ -d "$1" ] \
    || { echo "cannot mkdir $1" >&2; return 1; }
  exec 9>"$lockdir/$(basename "$1").lock"
  if [ "${2:-wait}" = "nowait" ]; then
    flock -n 9 || { echo "REFUSE: $1 locked (중복 실행?) — 먼저 끝낸 뒤 재실행" >&2; return 1; }
  else
    flock 9
  fi
}

# ---- 실패 시 재실행줄 (copy-paste용) ----
# 모든 .sh가 이 파일을 source하므로 여기서 EXIT trap 1회 설치로 전 스크립트 커버.
# 종료코드 != 0이면 `+ FORCE=1 <env핀> ./스크립트 <원본인자>` 1줄을 stderr에 출력.
# 성공 시 무출력. 서브셸 실패는 최상위에서 1회만 출력 (BASH_SUBSHELL 가드).
# run-*.sh는 `trap run_done EXIT` 대신 하단 체인형을 쓴다 (run_done rc 보존).
# 형식: + FORCE=1 [필요한 것만] ./스크립트 <원본인자> (짧게 유지)
# - PROFILE/INFRA: 항상 핀 (common.env가 전 스크립트 대신 참조. 없으면 ddp 재실행줄이
#   맨 셸에서 refuse된다 — 실측).
# - MODE/STRAT: 파일 내 $VAR/${VAR 리터럴이 있을 때만 (주석 매치는 허용 — 안전 방향).
# - MASTER_ADDR/MASTER_PORT/NODE_RANK/TP: PROFILE=2x일 때만 (1x에선 무의미/기본값).
#   2x에서 빠지면 refuse(MASTER_ADDR) 또는 rank 뒤바뀜이라 필수다.
# - 파일을 못 읽으면 4개 전부 (fail-safe). FORCE=1 선두 고정.
_M1B_SRC="${BASH_SOURCE[1]:-}"
if [ -n "$_M1B_SRC" ]; then
  M1B_SCRIPT_PATH="$(cd "$(dirname "$_M1B_SRC")" && pwd)/$(basename "$_M1B_SRC")"
else
  M1B_SCRIPT_PATH=""
fi
unset _M1B_SRC
M1B_SCRIPT="$(basename "${BASH_SOURCE[1]:-$0}")"
m1b_repro_cmd() { # 재실행줄 1줄을 stdout에 출력
  local cmd="+ FORCE=1" v
  for v in PROFILE INFRA MODE STRAT MASTER_ADDR MASTER_PORT NODE_RANK TP REPORT_TO; do
    case "$v" in
      PROFILE|INFRA|REPORT_TO) ;;                  # 항상 핀
      MODE|STRAT)                                   # 참조할 때만
        if [ -n "$M1B_SCRIPT_PATH" ] && [ -r "$M1B_SCRIPT_PATH" ] \
          && ! grep -qE '\$'"$v"'([^[:alnum:]_]|$)' "$M1B_SCRIPT_PATH" \
          && ! grep -qE '\$\{'"$v"'([^[:alnum:]_]|$)' "$M1B_SCRIPT_PATH"; then
          continue
        fi ;;  # 못 읽으면 핀 (fail-safe)
      *)                                            # 2x일 때만
        [ "${PROFILE:-1x}" = "2x" ] || continue ;;
    esac
    local val="${!v:-}"
    [ -n "$val" ] || continue
    local q
    printf -v q '%q' "$val"
    cmd="$cmd $v=$q"
  done
  cmd="$cmd ./$M1B_SCRIPT"
  # 원본 argv (/proc) — argv0(shell) + 스크립트 경로 제외, 나머지 그대로
  if [ -r /proc/$$/cmdline ]; then
    local -a argv=()
    local a
    while IFS= read -r -d '' a; do argv+=("$a"); done < /proc/$$/cmdline
    local start=1
    if [ "${#argv[@]}" -ge 2 ] && [ "$(basename -- "${argv[1]}")" = "$M1B_SCRIPT" ]; then
      start=2
    fi
    local i q
    for ((i = start; i < ${#argv[@]}; i++)); do
      printf -v q '%q' "${argv[$i]}"
      cmd="$cmd $q"
    done
  fi
  echo "$cmd"
}
m1b_repro_echo() { # 시작 시점 출력용 (터미널이면 green)
  local line
  line="$(m1b_repro_cmd)"
  if [ -t 1 ]; then printf '\e[32m%s\e[0m\n' "$line"; else echo "$line"; fi
}
m1b_repro() { # $M1B_RC != 0이면 재실행줄 출력 후 $M1B_RC로 복귀 (trap 체인용)
  local rc="${M1B_RC:-0}"
  if [ "$rc" -ne 0 ] && [ "${BASH_SUBSHELL:-0}" = "0" ]; then
    m1b_repro_cmd >&2
  fi
  return "$rc"
}
trap 'M1B_RC=$?; m1b_repro' EXIT

# ---- 구 p5_* 호환 alias (마이그레이션 기간) ----
# 외부에서旧 이름을 참조해도 동작하도록 위임.
p5_log() { m1b_log "$@"; }
p5_require() { m1b_require "$@"; }
p5_fresh() { m1b_fresh "$@"; }
p5_resolve_strat() { m1b_resolve_strat "$@"; }
p5_lock() { m1b_lock "$@"; }
p5_repro_cmd() { m1b_repro_cmd "$@"; }
p5_repro_echo() { m1b_repro_echo "$@"; }
p5_repro() { m1b_repro "$@"; }
