{
  //   14-baseline-train.sh → torchrun train-entry.py
  //   26-fft-train.sh      → torchrun train-entry.py (synthetic 입력)
  //   28-qlora-train.sh    → torchrun train-entry.py --peft
  //   22-generate.sh       → uv run 22-generate.py
  //   51-eval.sh           → uv run 51-eval.py (target 루프)
  //   53-upload-hf.sh      → uv run 53-upload-hf.py
  //   42-quant-gguf.sh     → $VENV_BIN/python $LLAMACPP/convert_hf_to_gguf.py (외부 파일)
  //   60-serve-vllm.sh     → $VLLM_BIN serve (vllm.entrypoints.openai.api_server 모듈)
  //   10-setup.sh          → python -c 인라인 한 줄 (파일 없음, 제외)
  //   16-compare-strategies.sh → python 없음 (cmp/sha256sum만, 제외)
  "version": "0.2.0",
  "inputs": [
    {
      "id": "m1bmode",
      "type": "promptString",
      "description": "mini | full",
      "default": "mini"
    },
    {
      "id": "m1btarget",
      "type": "promptString",
      "description": "51-eval target: base|fft|qlora|gptq|awq|fp8",
      "default": "fft"
    }
  ],
  "configurations": [
    {
      "name": "10-baseline (sh->py, dry-run)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "python": ".venv/bin/python",
      "program": "train-entry.py",
      "cwd": "${workspaceFolder}/math-1b-sft-and-quantization",
      "justMyCode": true,
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "--model",
        "unsloth/Llama-3.2-1B",
        "--train",
        "/rosenas/data/AIML/math-1b-shared/datasets/gsm8k-train.jsonl",
        "--out",
        "/tmp/m1b-debug/base-gsm8k-mini-single",
        "--epochs",
        "1",
        "--mode",
        "mini",
        "--strategy",
        "single",
        "--accum",
        "32",
        "--max_rows",
        "4",
        "--dry_run"
      ]
    },
    {
      "name": "10-baseline (torchrun single/mini)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "module": "torch.distributed.run",
      "python": ".venv/bin/python",
      "cwd": "${workspaceFolder}/math-1b-sft-and-quantization",
      "justMyCode": true,
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "--nproc_per_node=1",
        "${workspaceFolder}/train-entry.py",
        "--model",
        "unsloth/Llama-3.2-1B",
        "--train",
        "/rosenas/data/AIML/math-1b-shared/datasets/gsm8k-train.jsonl",
        "--out",
        "/tmp/m1b-debug/base-gsm8k-mini-single",
        "--epochs",
        "1",
        "--mode",
        "mini",
        "--strategy",
        "single",
        "--accum",
        "32",
        "--max_rows",
        "4"
      ]
    },
    {
      "name": "30-fft (torchrun single/mini)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "module": "torch.distributed.run",
      "python": ".venv/bin/python",
      "cwd": "${workspaceFolder}/math-1b-sft-and-quantization",
      "justMyCode": true,
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "--nproc_per_node=1",
        "${workspaceFolder}/train-entry.py",
        "--model",
        "unsloth/Llama-3.2-1B",
        "--train",
        "/rosenas/data/AIML/math-1b-shared/datasets/synthetic-mini.jsonl",
        "--out",
        "/tmp/m1b-debug/synthetic-fft-mini-single",
        "--epochs",
        "1",
        "--mode",
        "mini",
        "--strategy",
        "single",
        "--accum",
        "32",
        "--max_rows",
        "4"
      ]
    },
    {
      "name": "31-qlora --peft (torchrun single/mini)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "module": "torch.distributed.run",
      "python": ".venv/bin/python",
      "cwd": "${workspaceFolder}/math-1b-sft-and-quantization",
      "justMyCode": true,
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "--nproc_per_node=1",
        "${workspaceFolder}/train-entry.py",
        "--peft",
        "--model",
        "unsloth/Llama-3.2-1B",
        "--train",
        "/rosenas/data/AIML/math-1b-shared/datasets/synthetic-mini.jsonl",
        "--out",
        "/tmp/m1b-debug/synthetic-qlora-mini-single",
        "--epochs",
        "1",
        "--mode",
        "mini",
        "--strategy",
        "single",
        "--accum",
        "32",
        "--max_rows",
        "4"
      ]
    },
    {
      "name": "22-teacher-to-generate-syn-data (22-teacher-to-generate-syn-data.sh -> 22-teacher-to-generate-syn-data.py)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "python": ".venv/bin/python",
      "program": "22-teacher-to-generate-syn-data.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "--mode",
        "${input:m1bmode}",
        "--tp",
        "1",
        "--maxlen",
        "4096",
        "--teacher",
        "meta-llama/Llama-3.1-8B-Instruct",
        "--n",
        "2"
      ]
    },
    {
      "name": "51-eval (51-eval.sh -> 51-eval.py)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "python": ".venv/bin/python",
      "program": "51-eval.py",
      "cwd": "${workspaceFolder}/math-1b-sft-and-quantization",
      "justMyCode": true,
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "--mode",
        "${input:m1bmode}",
        "--target",
        "${input:m1btarget}",
        "--n",
        "2",
        "--tp",
        "1"
      ]
    },
    {
      "name": "53-upload (53-upload-hf.sh -> 53-upload-hf.py, dry-run)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "python": ".venv/bin/python",
      "program": "53-upload-hf.py",
      "cwd": "${workspaceFolder}/math-1b-sft-and-quantization",
      "justMyCode": true,
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "--mode",
        "${input:m1bmode}",
        "--targets",
        "all",
        "--dry-run"
      ]
    },
    {
      "name": "42-gguf convert (42-quant-gguf.sh -> convert_hf_to_gguf.py)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "python": ".venv/bin/python",
      "program": "${env:HOME}/git/llama.cpp/convert_hf_to_gguf.py",
      "cwd": "${workspaceFolder}/math-1b-sft-and-quantization",
      "justMyCode": false,
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "/rosenas/data/AIML/math-1b-shared/models/synthetic-fft-mini-single",
        "--outfile",
        "/tmp/m1b-debug/model-f16.gguf"
      ]
    },
    {
      "name": "60-serve vllm (60-serve-vllm.sh -> vllm serve)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "module": "vllm.entrypoints.openai.api_server",
      "python": ".venv/bin/python",
      "cwd": "${workspaceFolder}/math-1b-sft-and-quantization",
      "justMyCode": false,
      "env": {
        "UV_NO_SYNC": "1",
        "VLLM_ATTENTION_BACKEND": "FLASH_ATTN",
        "VLLM_USE_FLASHINFER_SAMPLER": "0"
      },
      "args": [
        "--model",
        "/rosenas/data/AIML/math-1b-shared/models/synthetic-fft-mini-single",
        "--served-model-name",
        "tayaee/m1b-1B-math-fft-mini",
        "--tensor-parallel-size",
        "1",
        "--max-model-len",
        "2048",
        "--gpu-memory-utilization",
        "0.9",
        "--trust-remote-code",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ]
    },
    {
      "name": "18-select-candidates (uv run 직접실행)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/18-select-candidates.py",
      "cwd": "${workspaceFolder}",
      "env": {
        "UV_NO_SYNC": "1"
      },
      "args": [
        "--mode",
        "${input:m1bmode}",
        "--seed",
        "1"
      ]
    },
    {
      "name": "20-build-prompts (uv run 직접실행)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv-sync",
      "python": ".venv/bin/python",
